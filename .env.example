# ============================================================
#  QZ Motor Center — API Gateway
#  Copia este archivo como .env y ajusta los valores
# ============================================================

# --- Servidor ------------------------------------------------
PORT=4000
NODE_ENV=development

# --- CORS ----------------------------------------------------
# Orígenes separados por coma. Ejemplo: http://localhost:5173,https://miapp.com
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting -------------------------------------------
# Global: 100 requests por ventana de 15 minutos
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Rutas de autenticación: máximo 10 requests por minuto
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Microservices URLs --------------------------------------
AUTH_API_URL=http://localhost:8081
CARS_API_URL=http://localhost:3001
MOTORCYCLES_API_URL=http://localhost:5000
ELECTROBIKES_API_URL=https://qzmotorcenter-electrobike-api.onrender.com
SCOOTERS_API_URL=http://localhost:3003
REPORTS_API_URL=http://localhost:8080
AI_API_URL=http://localhost:8000
SERVERLESS_API_URL=http://localhost:3004
