# QZ Motor Center - API Gateway
# Copia este archivo como .env y ajusta los valores faltantes.

PORT=4000
NODE_ENV=development

# --- CORS ----------------------------------------------------
# Orígenes separados por coma. Ejemplo: http://localhost:5173,https://miapp.com
CORS_ORIGIN=http://localhost:5173,https://qzmotorcenterfrontend.onrender.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Microservices URLs. El frontend NO debe usar estas URLs directamente.
AUTH_API_URL=http://localhost:8081
CARS_API_URL=http://localhost:3001
MOTORCYCLES_API_URL=https://qzmotorcenter-motorcycles-api.onrender.com
ELECTROBIKES_API_URL=https://qzmotorcenter-electrobike-api.onrender.com
SCOOTERS_API_URL=http://localhost:3003
REPORTS_API_URL=https://qzmotorcenterreports-1.onrender.com
AI_API_URL=http://localhost:8000
SERVERLESS_API_URL=http://localhost:3004
